Result<bool> Codec<::golden::all::Scalars>::readField([[maybe_unused]] TaggedReader& r, [[maybe_unused]] FieldTag tag, [[maybe_unused]] ::golden::all::Scalars& v) {
    switch (tag.id) {
        case 1u: return ::helios::refl::readKnownField(r, tag.wire, v.b);
        case 2u: return ::helios::refl::readKnownField(r, tag.wire, v.i8v);
        case 3u: return ::helios::refl::readKnownField(r, tag.wire, v.i16v);
        case 4u: return ::helios::refl::readKnownField(r, tag.wire, v.i32v);
