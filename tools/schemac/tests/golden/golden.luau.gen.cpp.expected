namespace golden::all {

::helios::u32 bindQueries(::helios::script::Binder& binder, Queries& impl, std::string_view realm) {
    nameIdTags(binder.state());
    ::helios::u32 count = 0;
    if (realm == "server" || realm == "client") {
        binder.function("Queries", "nearest", &glue_Queries_nearest, ::helios::script::FuelCost{12u, 0u, 0}, &impl);
        ++count;
    }
    if (realm == "server" || realm == "client") {
        binder.function("Queries", "inRadius", &glue_Queries_inRadius, ::helios::script::FuelCost{20u, 0u, 0}, &impl);
        ++count;
    }
    if (realm == "server") {
        binder.function("Queries", "spawn", &glue_Queries_spawn, ::helios::script::FuelCost{50u, 0u, 0}, &impl);
        ++count;
    }
    if (realm == "server" || realm == "client") {
        binder.function("Queries", "convert", &glue_Queries_convert, ::helios::script::FuelCost{3u, 2000u, 13}, &impl);
        ++count;
    }
    if (realm == "editor") {
        binder.function("Queries", "echo", &glue_Queries_echo, ::helios::script::FuelCost{1u, 0u, 0}, &impl);
        ++count;
    }
    if (realm == "server" || realm == "client") {
        binder.function("Queries", "log", &glue_Queries_log, ::helios::script::FuelCost{2u, 1000u, 1}, &impl);
        ++count;
    }
    return count;
}

} // namespace golden::all
