{
  "description": "Literals, precedence, associativity and IEEE-754 arithmetic (+ - * / unary -), signed zero, infinities and NaN.",
  "cases": [
    { "name": "arith.int", "src": "42", "bytecode": "bb1b6fe9fced83a2", "type": "num", "expect": 42 },
    { "name": "arith.zero", "src": "0", "bytecode": "ca9a130c17e0e4e9", "expect": 0 },
    { "name": "arith.decimal", "src": "0.1", "bytecode": "3aaf16214dc6bf46", "expect": "0x1.999999999999ap-4" },
    { "name": "arith.leading_dot", "src": ".5", "bytecode": "6b386ad5c27f5ee2", "expect": 0.5 },
    { "name": "arith.trailing_dot", "src": "5.", "bytecode": "d808556bc30467c5", "expect": 5 },
    { "name": "arith.exponent", "src": "1.5e3", "bytecode": "d1c67d477a1d523c", "expect": 1500 },
    { "name": "arith.exponent_neg", "src": "25E-2", "bytecode": "0393813a320c10f2", "expect": 0.25 },
    { "name": "arith.exponent_plus", "src": "1e+2", "bytecode": "880f244e6d5716be", "expect": 100 },
    { "name": "arith.max_literal", "src": "1.7976931348623157e308", "bytecode": "a7af5de330c37241", "expect": "0x1.fffffffffffffp+1023" },
    { "name": "arith.min_normal_literal", "src": "2.2250738585072014e-308", "bytecode": "dd25d3854a5d7db9", "expect": "0x1p-1022" },
    { "name": "arith.long_literal", "src": "3.14159265358979323846264338327950288419716939937510", "bytecode": "912ca4140c561b57", "expect": "0x1.921fb54442d18p+1" },
    { "name": "arith.round_half_even_literal", "src": "9007199254740993", "bytecode": "e19b62a87d259786", "expect": 9007199254740992,
      "comment": "2^53 + 1 rounds to even (2^53)" },
    { "name": "arith.round_up_literal", "src": "9007199254740995", "bytecode": "795d9d7b6bbef0d4", "expect": 9007199254740996 },
    { "name": "arith.add", "src": "1 + 2", "bytecode": "6359c20613188e8f", "expect": 3 },
    { "name": "arith.sub", "src": "5 - 7", "bytecode": "ad3173550574ed4d", "expect": -2 },
    { "name": "arith.mul", "src": "6 * 7", "bytecode": "61c303a0959020b6", "expect": 42 },
    { "name": "arith.div", "src": "1 / 4", "bytecode": "e4bcd0975b809960", "expect": 0.25 },
    { "name": "arith.div_inexact", "src": "1 / 3", "bytecode": "98dc5e44a96e76a8", "expect": "0x1.5555555555555p-2" },
    { "name": "arith.point_one_plus_point_two", "src": "0.1 + 0.2", "bytecode": "aab34369d7c7bcd0", "expect": "0x1.3333333333334p-2" },
    { "name": "arith.precedence_mul", "src": "1 + 2 * 3", "bytecode": "753e7485f06900c9", "expect": 7 },
    { "name": "arith.precedence_paren", "src": "(1 + 2) * 3", "bytecode": "0b02398e80e1bf08", "expect": 9 },
    { "name": "arith.left_assoc_sub", "src": "10 - 4 - 3", "bytecode": "381100dc5e38a9cd", "expect": 3 },
    { "name": "arith.left_assoc_div", "src": "24 / 4 / 3", "bytecode": "705a15df782b0c4d", "expect": 2 },
    { "name": "arith.no_reassociation", "src": "(0.1 + 0.2) + 0.3", "bytecode": "f2a2b78ccfb1ec21", "expect": "0x1.3333333333334p-1",
      "comment": "evaluated left to right, never reassociated to 0.1 + (0.2 + 0.3)" },
    { "name": "arith.no_reassociation_2", "src": "0.1 + (0.2 + 0.3)", "bytecode": "a1bfdcf96db9e1fc", "expect": "0x1.3333333333333p-1" },
    { "name": "arith.no_folding_mul", "src": "0.1 * 3", "bytecode": "c00e065f173d7bf9", "expect": "0x1.3333333333334p-2" },
    { "name": "arith.pow_binds_tighter_than_neg", "src": "-2 ^ 2", "bytecode": "5346cf14c193d3ad", "expect": -4 },
    { "name": "arith.pow_right_assoc", "src": "2 ^ 3 ^ 2", "bytecode": "c5b2c3a347791d9b", "expect": 512 },
    { "name": "arith.pow_neg_exponent", "src": "2 ^ -1", "bytecode": "d4efd801ea2ef23c", "expect": 0.5 },
    { "name": "arith.pow_paren_base", "src": "(-2) ^ 2", "bytecode": "8aa1b7debd6749d9", "expect": 4 },
    { "name": "arith.pow_mul", "src": "3 * 2 ^ 2", "bytecode": "cc5502d6641b5593", "expect": 12 },
    { "name": "arith.double_neg", "src": "--3", "bytecode": "c51b0bcef3acc9d5", "expect": 3 },
    { "name": "arith.neg_mul", "src": "2 * -3", "bytecode": "3456a22c706651fe", "expect": -6 },
    { "name": "arith.neg_zero", "src": "-0", "bytecode": "7ce7c95ddd8e3eb1", "expect": "-0" },
    { "name": "arith.zero_times_neg", "src": "0 * -1", "bytecode": "c0cd295226b2ad97", "expect": "-0" },
    { "name": "arith.neg_zero_plus_zero", "src": "-0 + 0", "bytecode": "7afa0c52cd5cc7ac", "expect": 0 },
    { "name": "arith.neg_zero_minus_zero", "src": "-0 - 0", "bytecode": "7afa0f52cd5cccc5", "expect": "-0" },
    { "name": "arith.zero_minus_zero", "src": "0 - 0", "bytecode": "65d8a220e110b957", "expect": 0 },
    { "name": "arith.x_minus_x", "src": "1.5 - 1.5", "bytecode": "d1fc44f2d4acb6b0", "expect": 0 },
    { "name": "arith.div_by_zero", "src": "1 / 0", "bytecode": "d82ac47c053a51d0", "expect": "inf" },
    { "name": "arith.neg_div_by_zero", "src": "-1 / 0", "bytecode": "e850c5e49baee28a", "expect": "-inf" },
    { "name": "arith.div_by_neg_zero", "src": "1 / -0", "bytecode": "f28f31569c55ec1e", "expect": "-inf" },
    { "name": "arith.zero_div_zero", "src": "0 / 0", "bytecode": "65d8a020e110b5f1", "expect": "nan" },
    { "name": "arith.neg_nan_canonical", "src": "-(0 / 0)", "bytecode": "b2e08f1cc9a712f5", "expect": "nan",
      "comment": "NaN results are canonical: the sign of a NaN is never observable" },
    { "name": "arith.inf_minus_inf", "src": "1/0 - 1/0", "bytecode": "e08f756ef66cc1b0", "expect": "nan" },
    { "name": "arith.inf_times_zero", "src": "(1/0) * 0", "bytecode": "8a949f57dd9537e9", "expect": "nan" },
    { "name": "arith.inf_plus_one", "src": "1/0 + 1", "bytecode": "933e1657e27d2fc8", "expect": "inf" },
    { "name": "arith.one_div_inf", "src": "1 / (1/0)", "bytecode": "69a6ac6272a0ffe2", "expect": 0 },
    { "name": "arith.neg_one_div_inf", "src": "-1 / (1/0)", "bytecode": "2419725b83511306", "expect": "-0" },
    { "name": "arith.overflow_mul", "src": "1e308 * 10", "bytecode": "7b56ad74b94caa27", "expect": "inf" },
    { "name": "arith.overflow_add", "src": "1.7976931348623157e308 + 1e292", "bytecode": "36a78ca75360cc4f", "expect": "inf" },
    { "name": "arith.no_overflow_add", "src": "1.7976931348623157e308 + 1e291", "bytecode": "dda981aaa6c25ced", "expect": "0x1.fffffffffffffp+1023",
      "comment": "below half an ulp of DBL_MAX: rounds back to DBL_MAX" },
    { "name": "arith.whitespace_and_comments", "src": "  1 +\n\t// a comment\r\n  2 ; // trailing\n", "bytecode": "6359c20613188e8f", "expect": 3 },
    { "name": "arith.semicolon", "src": "7;", "bytecode": "cfb791259f39fadd", "expect": 7 },
    { "name": "arith.const_dedup", "src": "2 + 2 * 2 - 2", "bytecode": "6d67e07b9014ce34", "expect": 4 },
    { "name": "arith.chain_200", "src": "", "bytecode": "b0588bf3fc599445", "expect": 200 },
    { "name": "arith.deep_parens", "src": "((((((((((((((((((((((((((((((((1))))))))))))))))))))))))))))))))", "bytecode": "9e01724c9258ef92", "expect": 1 },
    { "name": "arith.formula_decl", "src": "formula Twice(a) = a.x * 2", "bytecode": "4baf142f134ca51d",
      "inputs": { "fields": { "a": { "x": 21 } } }, "expect": 42 },
    { "name": "arith.formula_no_params", "src": "formula Pi() = 3.141592653589793;", "bytecode": "28f6224572d14a31", "expect": "0x1.921fb54442d18p+1" },
    { "name": "arith.formula_ignores_host_params", "src": "formula F(q) = q.v", "params": ["x", "y"], "bytecode": "76a4986466d45fbb",
      "inputs": { "fields": { "q": { "v": 5 } } }, "expect": 5 }
  ]
}
