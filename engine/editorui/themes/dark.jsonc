// Helios editor theme: dark (default). Colors are sRGB "#RRGGBB" or "#RRGGBBAA"; metrics are in
// DIPs at 100 % scale. Every text/background pair used by the shell must reach 4.5:1 contrast
// (WCAG 2.2 AA; the layout lint of 07 §4.4 checks it).
{
  "name": "dark",
  "highContrast": false,
  "colors": {
    "text": "#E3E6EA",
    "textDisabled": "#A6ADB7",
    "windowBg": "#1D2025",
    "childBg": "#1D2025",
    "popupBg": "#23272D",
    "border": "#3B4048",
    "frameBg": "#2A2F36",
    "frameBgHovered": "#343A42",
    "frameBgActive": "#2F353D",
    "titleBg": "#17191D",
    "titleBgActive": "#22262C",
    "menuBarBg": "#17191D",
    "scrollbarBg": "#1D2025",
    "scrollbarGrab": "#4A515B",
    "checkMark": "#6CB6FF",
    "sliderGrab": "#6CB6FF",
    "button": "#2C5282",
    "buttonHovered": "#35629B",
    "buttonActive": "#264873",
    "header": "#2B3848",
    "headerHovered": "#324256",
    "headerActive": "#253140",
    "separator": "#3B4048",
    "tab": "#22262C",
    "tabHovered": "#344559",
    "tabSelected": "#2B3848",
    "tabDimmed": "#1B1E22",
    "tabDimmedSelected": "#262B32",
    "dockingPreview": "#6CB6FF66",
    "tableHeaderBg": "#262A30",
    "tableRowBgAlt": "#FFFFFF08",
    "textSelectedBg": "#6CB6FF55",
    "navHighlight": "#6CB6FF",
    "statusBarBg": "#17191D",
    "accentLocal": "#4A515B",
    "accentShared": "#D9A441",
    "accentLive": "#D9534F",
    "badgeServer": "#E5A45A",
    "badgeClient": "#78C87C",
    "dirty": "#E5C35A",
    "error": "#FF7A7A",
    "viewportBg": "#2B3038",
    "viewportGrid": "#3B424D"
  },
  "metrics": {
    "fontSize": 15,
    "windowRounding": 2,
    "frameRounding": 2,
    "tabRounding": 2,
    "windowBorderSize": 1,
    "frameBorderSize": 0,
    "framePaddingX": 6,
    "framePaddingY": 3,
    "itemSpacingX": 8,
    "itemSpacingY": 4
  }
}
