    },
    {
      "id": "NS-0.5", "phase": 0, "source": "04 §11.4", "owner": "WP-0.15",
      "title": "Go-minted tokens accepted by vendored netcode",
      "class": "N", "platforms": ["linux", "windows"],
      "threshold": "Go-issued golden connect tokens decode byte-exactly and complete the handshake in C++; an expired one is refused",
      "status": "measured",
      "tests": [
        {"doctest": "net_tests", "case": "Go golden vectors: public and private parts decode byte-exactly"},
        {"doctest": "net_tests", "case": "Go golden vector: a never-expiring Go-issued token completes the handshake"},
        {"doctest": "net_tests", "case": "Go golden vector: an expired Go-issued token is refused"},
        {"doctest": "server_tests", "case": "server.contracts: connect-token user data matches Go's layout v1"},
        {"go": "pkg/connecttoken", "test": "TestFixedVectorsByteExact"},
        {"go": "pkg/connecttoken", "test": "TestNetcodeAPIVectorDecrypts"},
        {"go": "pkg/connecttoken", "test": "TestNetcodeCInterop", "platforms": ["linux"]}
      ]
    },
    {
      "id": "NS-0.6", "phase": 0, "source": "04 §11.4", "owner": "WP-0.14",
      "title": "Empty-zone tick < 0.5 ms",
