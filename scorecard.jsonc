  ],

  // ------------------------------------------------------------------------------------------------
  // Phase 0 exit items that are not scorecard criteria (09 §2.1 "Exit", 01 §5.4, 09 §5.7).
  // ------------------------------------------------------------------------------------------------
  "exit": [
    {
      "id": "EXIT-0.ci-green", "phase": 0, "source": "01 §5.4", "owner": "WP-0.1",
      "title": "CI green on every toolchain",
      "class": "N", "platforms": ["linux", "windows"],
      "threshold": "AAA-PLT-1 passes",
      "status": "partial",
      "tests": [
        {"ci_job": "Backend services (Go, windows-latest)"},
        {"ci_job": "Backend services (Go, ubuntu-24.04)"},
        {"ci_job": "Backend integration (embedded PostgreSQL/NATS, Linux, non-root)"}
      ],
      "gaps": [{"clause": "Follows AAA-PLT-1 (the windows-msvc-dev job)", "state": "unmeasured", "owner": "WP-0.6c"}]
    },
    {
      "id": "EXIT-0.schemac-emitters", "phase": 0, "source": "01 §5.4", "owner": "WP-0.7b",
      "title": "helios-schemac emits C++, Go, Luau and SQL from one package",
