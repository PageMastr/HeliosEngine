-# A Unix socket in WORK_DIR (no TCP port shared with other builds); Windows uses loopback TCP.
+
+# Creates a private (0700) directory for the server's Unix socket and stores it in `out_var`. The socket file
+# is "<dir>/.s.PGSQL.<port>" and must fit sockaddr_un.sun_path (107 bytes on Linux, 103 on macOS), which a socket
+# in WORK_DIR does not once the build directory is a few levels deep: the linux-asan nightly's
+# build/linux-debug-asan made it 108 bytes ("could not create any Unix-domain sockets"). So the socket lives
+# under the temp dir ($TMPDIR, else /tmp when that is missing or too long), in a directory named at random, so
+# concurrent runs (ctest -j, several build trees) never share one.
+function(make_socket_dir out_var)
+  set(path_max 100) # the longest socket path accepted, below the smallest sun_path with room to spare
+  foreach(root "$ENV{TMPDIR}" "/tmp")
+    string(REGEX REPLACE "/+$" "" root "${root}")
+    if(NOT root OR NOT IS_DIRECTORY "${root}")
+      continue()
+    endif()
+    string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" id)
+    set(dir "${root}/helios-pg-${id}")
+    string(LENGTH "${dir}/.s.PGSQL.${port}" len)
+    if(len GREATER path_max OR EXISTS "${dir}")
+      continue()
+    endif()
+    file(MAKE_DIRECTORY "${dir}")
+    file(CHMOD "${dir}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
+    set(${out_var} "${dir}" PARENT_SCOPE)
+    return()
+  endforeach()
+  message(FATAL_ERROR "sql_postgres: no usable temp directory for the server's Unix socket (TMPDIR='$ENV{TMPDIR}')")
+endfunction()
+
+# Removes the socket directory (the server's own shutdown deletes its socket, a killed one does not).
+macro(remove_socket_dir)
+  if(socket_dir)
+    file(REMOVE_RECURSE "${socket_dir}")
+  endif()
+endmacro()
+
+# No TCP port is shared with other builds: a Unix socket (listen_addresses is empty), or loopback TCP on Windows.
+set(socket_dir "")
