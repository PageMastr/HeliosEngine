// Helios AAA scorecard registry (docs/plan/09-roadmap-and-process.md §5.6–5.8; WP-0.3).
//
// Every acceptance criterion is registered here with its evidence class, platforms, threshold and the
// tests that evidence it (09 §5.3 DoD item 8). The nightly report evaluates each entry from JUnit, doctest
// XML and `go test -json` results; this file never says that a criterion passes. An entry whose clauses
// have no test yet says so: `status` is "partial" or "unmeasured" and `gaps` names each missing or
// known-failing clause and the WP that owns it. A gap can never be green (09 §0 principle 4).
// `threshold` quotes the plan; how a test reads a clause goes in `notes`.
//
// Check it with `python3 tools/scorecard/scorecard.py check` (CTest `lint_scorecard`); the format and the
// checker are described in tools/scorecard/README.md.
{
  "version": 1,
  "plan_rev": 6,
  // Phases whose every criterion must be registered (the checker derives them from docs/plan).
  "covers": [0],

  // Result sets the nightly workflow produces. `default` runs count for every reference on their OS;
  // the others count only for references that name them with "run".
  "runs": {
    "linux-gcc": {"os": "linux", "default": true,
                  "description": "Linux GCC RelWithDebInfo: every CTest (lavapipe under Xvfb), perf serially, net_bench --gate"},
    "linux-clang": {"os": "linux", "default": true,
                    "description": "Linux Clang RelWithDebInfo: every CTest except perf (lavapipe under Xvfb)"},
    "linux-asan": {"os": "linux", "default": false,
                   "description": "Linux Clang Debug with ASan and UBSan"},
    "linux-fuzz": {"os": "linux", "default": true,
                   "description": "libFuzzer (Clang, -fsanitize=fuzzer with ASan and UBSan), 1 h per engine/net target"},
    "windows-vs2026": {"os": "windows", "default": true,
                       "description": "Windows MSBuild, VS 2026 (primary toolset), RelWithDebInfo, no GPU, net_bench --gate"},
    "windows-vs2022": {"os": "windows", "default": true,
                       "description": "Windows MSBuild, VS 2022 (floor toolset), RelWithDebInfo, no GPU"},
    "windows-clang-cl": {"os": "windows", "default": true,
                         "description": "Windows clang-cl RelWithDebInfo (Ninja), no GPU"},
    "linux-go": {"os": "linux", "default": true,
                 "description": "go test ./... and -tags integration (embedded PostgreSQL), HELIOS_NETCODE_INTEROP=1"},
    "windows-go": {"os": "windows", "default": true,
                   "description": "go test ./... and -tags integration (embedded PostgreSQL)"}
  },

  // Commands the nightly workflow runs outside CTest; each writes one JUnit result named after the gate.
  "gates": {
    "net_bench_gate": {"runs": ["linux-gcc", "windows-vs2026"], "min_seconds": 600,
                       "description": "net_bench --gate: NS-0.2 raw and encrypted-stack pps per core, NS-0.7 600 s trunk run"},
    "libfuzzer_packet_parser": {"runs": ["linux-fuzz"], "min_seconds": 3600,
                                "description": "net_fuzz_packet_parser under libFuzzer for 1 h"},
    "libfuzzer_connection_receive": {"runs": ["linux-fuzz"], "min_seconds": 3600,
                                     "description": "net_fuzz_connection_receive under libFuzzer for 1 h"},
    "libfuzzer_connect_token": {"runs": ["linux-fuzz"], "min_seconds": 3600,
                                "description": "net_fuzz_connect_token under libFuzzer for 1 h"},
    "libfuzzer_server_datagram": {"runs": ["linux-fuzz"], "min_seconds": 3600,
                                  "description": "net_fuzz_server_datagram under libFuzzer for 1 h"},
    "libfuzzer_address_parse": {"runs": ["linux-fuzz"], "min_seconds": 3600,
                                "description": "net_fuzz_address_parse under libFuzzer for 1 h"}
  },

  // Numbers the perf gates print, tracked night by night by tools/scorecard/perf.py against the 09 §5.8
  // budgets of their category (render and runtime ±5 %, backend, editor and iteration ±10 %). `pattern`
  // captures the number from a doctest case's MESSAGE lines or a gate's output.
  "perf_metrics": [
    {"id": "net.ns02.socket_pps_per_core", "criterion": "NS-0.2", "gate": "net_bench_gate",
     "pattern": "NS-0\\.2 socket: \\d+/\\d+ datagrams, (\\d+) pps per core", "unit": "pps/core", "better": "higher", "category": "runtime"},
    {"id": "net.ns02.stack_packets_per_core", "criterion": "NS-0.2", "gate": "net_bench_gate",
     "pattern": "NS-0\\.2 HTP stack: \\d+/\\d+ encrypted packets delivered, (\\d+) packets per core", "unit": "packets/core", "better": "higher", "category": "runtime"},
    {"id": "net.ns07.trunk_delivered_pps", "criterion": "NS-0.7", "gate": "net_bench_gate",
     "pattern": "NS-0\\.7 trunk: [\\d.]+ s, sent \\d+, delivered \\d+ \\((\\d+) pps", "unit": "pps", "better": "higher", "category": "runtime"},
    {"id": "net.ns07.trunk_cell_cores", "criterion": "NS-0.7", "gate": "net_bench_gate",
     "pattern": "NS-0\\.7 trunk: .*?cell thread ([\\d.]+) cores", "unit": "cores", "better": "lower", "category": "runtime"},
    {"id": "net.ns02.loopback_pps_per_core", "criterion": "NS-0.2", "doctest": "net_tests",
     "case": "perf: NS-0.2: loopback 100k pps per core without loss", "run": "linux-gcc",
     "pattern": "-> (\\d+) pps per core", "unit": "pps/core", "better": "higher", "category": "runtime"},
    {"id": "script.fuel_metering_overhead_pct", "criterion": "RT-13", "doctest": "script_tests",
     "case": "perf: fuel metering overhead and ns per fuel", "run": "linux-gcc",
     "pattern": "metering overhead ([\\d.]+) %", "unit": "%", "better": "lower", "category": "runtime"},
    {"id": "script.trivial_resume_ns", "doctest": "script_tests",
     "case": "perf: host cost of a trivial resume versus FuelBudget::resumeCost", "run": "linux-gcc",
     "pattern": "trivial resume: ([\\d.]+) ns", "unit": "ns", "better": "lower", "category": "runtime"},
    {"id": "pcg.cpu_vm_avx2_ms_per_tile", "doctest": "pcg_tests",
     "case": "perf: CPU VM ms per 65x65 tile per core on the dispatched AVX2 kernel (03 §5.5a budget 0.5 ms)", "run": "linux-gcc",
     "pattern": "avx2 ([\\d.]+) ms", "unit": "ms", "better": "lower", "category": "runtime"},
    {"id": "schemac.regenerate_2000_types_s", "doctest": "schemac_tests",
     "case": "perf: 2,000 types regenerate within the 02 §3.5 budget", "run": "linux-gcc",
     "pattern": "types, \\d+ outputs \\(\\d+ KiB\\) in ([\\d.]+) s", "unit": "s", "better": "lower", "category": "iteration"}
  ],

  // ------------------------------------------------------------------------------------------------
  // Phase 0 criteria: every criterion whose plan phase includes 0, plus the IDs named in 09 §2.1's
  // exit (the checker derives both lists from docs/plan and fails if one is missing here).
  // ------------------------------------------------------------------------------------------------
  "criteria": [
    {
      "id": "AAA-PLT-1", "phase": 0, "source": "01 §3.10", "owner": "WP-0.1",
      "title": "Every commit builds and tests on the ADR-001a 8-job PR matrix",
      "class": "N", "platforms": ["linux", "windows"],
      "threshold": "Every commit builds and tests on both MSVC toolsets of ADR-001a (the primary VS 2026 v145, and the VS 2022 17.14 floor at MSVC 14.44, which also builds the SDK and every released Windows binary), clang-cl, GCC 13 and Clang 17, plus the MinGW cross-compile check: the 8-job PR matrix",
      "notes": "Evidenced by the jobs of the latest completed ci.yml run on main; WP-0.1's acceptance adds that floor and primary run identical tests and determinism hashes",
      "status": "partial",
      "tests": [
        {"ci_job": "Windows (MSVC, primary)"},
        {"ci_job": "Windows (MSVC 14.44 floor)"},
        {"ci_job": "Windows (clang-cl)"},
        {"ci_job": "Linux (linux-gcc)"},
        {"ci_job": "Linux (linux-clang)"},
        {"ci_job": "Linux (headless servers + tools)"},
        {"ci_job": "Windows cross-build (MinGW-w64)"}
      ],
      "gaps": [
        {"clause": "The modular windows-msvc-dev job (the eighth PR job) does not exist yet", "state": "unmeasured", "owner": "WP-0.6c"}
      ]
    },
    {
      "id": "AAA-PLT-2", "phase": 0, "source": "01 §3.10", "owner": "WP-0.15",
      "title": "All servers and helios-backend run natively on Windows without Docker (Phase 0 part)",
      "class": "N", "platforms": ["windows"],
      "threshold": "All servers and `helios-backend` run natively on Windows without Docker (Ph0)",
      "notes": "The Linux production images (Ph2) are Phase 2's entry",
      "status": "partial",
      "tests": [
        {"go": "internal/integration", "test": "TestRegisterLoginConnectToken", "tags": "integration"},
        {"go": "internal/integration", "test": "TestGatewayCellReconnectOverNATS", "tags": "integration"},
        {"go": "internal/stack", "test": "TestEmbeddedBusAndCache"},
        {"ctest": "server_tests"},
        {"ctest": "authority_tests"}
      ],
      "gaps": [
        {"clause": "No nightly job starts the helios-cell.exe and helios-gateway.exe executables against helios-backend.exe on Windows (tools/milestone/validate.ps1 does it at milestone validation, 09 §5.9)", "state": "unmeasured", "owner": "WP-0.14"}
      ]
    },
    {
      "id": "AAA-REN-7", "phase": 0, "source": "01 §3.3", "owner": "WP-0.12",
      "title": "Every render feature has a lavapipe golden from the commit that ships it, rendered twice bit-identically",
      "class": "N", "platforms": ["linux", "windows"],
      "threshold": "Every render feature has a lavapipe golden from the commit that ships it, whatever its REN-6 phase; each renders twice bit-identically; a failing golden blocks the merge",
      "notes": "Lavapipe goldens run on Linux CI; Windows runners have no Vulkan driver, so Windows is evidenced by the Null trace goldens. The PR-tier Linux jobs run the goldens, which is how a failing golden blocks the merge",
      "status": "partial",
      "tests": [
        {"ctest": "rendertest.vulkan.*", "platforms": ["linux"]},
        {"ctest": "rendertest.report", "platforms": ["linux"]},
        {"ctest": "rendertest.scenes"},
        {"ctest": "rendertest.null.*"},
        {"doctest": "render_tests", "case": "graph null: small frame trace golden (plan + command stream)"},
        {"doctest": "render_tests", "case": "forward: a frame on the Null backend (trace golden)"},
        {"doctest": "rhi_tests", "case": "null: command-stream trace golden for a small frame"},
        {"ci_job": "Linux (linux-gcc)"},
        {"ci_job": "Linux (linux-clang)"}
      ],
      "gaps": [
        {"clause": "Coverage: nothing checks mechanically that every shipped render feature has a golden (rendertest.scenes only checks that the CMake scene list equals createScenes())", "state": "unmeasured", "owner": "WP-0.12"},
        {"clause": "MinGW: the cross-built binaries are never executed, so the Null traces are not checked on MinGW", "state": "unmeasured", "owner": "WP-0.1"}
      ]
    },
    {
      "id": "RC-1", "phase": 0, "source": "03 §9.3", "owner": "WP-0.12",
      "title": "Lavapipe goldens for every shipped feature, rendered twice; suite within 10 min; Null traces on all toolchains",
      "class": "N", "platforms": ["linux", "windows"],
      "threshold": "Every shipped feature has a lavapipe golden (ꟻLIP mean ≤ 0.01), rendered twice bit-identically; suite ≤ 10 min; Null traces on all toolchains",
      "notes": "rendertest.report checks the 10-minute budget (--budget 600)",
      "status": "partial",
      "tests": [
        {"ctest": "rendertest.vulkan.*", "platforms": ["linux"]},
        {"ctest": "rendertest.report", "platforms": ["linux"]},
        {"ctest": "rendertest.null.*"},
        {"ctest": "rendertest.cli"},
        {"ctest": "render_tests"},
        {"ctest": "rhi_tests"},
        {"ctest": "shaderc.spirv-val", "platforms": ["linux"]}
      ],
      "gaps": [
        {"clause": "Coverage: nothing checks mechanically that every shipped feature has a golden (rendertest.scenes only checks that the CMake scene list equals createScenes())", "state": "unmeasured", "owner": "WP-0.12"},
        {"clause": "MinGW: the cross-built binaries are never executed, so the Null traces are not checked on MinGW", "state": "unmeasured", "owner": "WP-0.1"}
      ]
    },
    {
      "id": "RT-03", "phase": 0, "source": "02 §8.2", "owner": "WP-0.9",
      "title": "Physics hash (Phase 0 scope): the scripted scene's golden on every determinism toolchain and worker count, and the permuted-BodyID variant",
      "class": "N", "platforms": ["linux", "windows"],
      "threshold": "Phase 0 scope (02 §8.1): small hash; `stable-order` patch and stable body keys (RT-03 permuted variant). From RT-03: identical on every determinism toolchain (both MSVC toolsets, clang-cl, GCC, Clang and MinGW), at 1/4/16 workers; the permuted variant is rebuilt so that every `BodyID` differs and must give the identical hash; a CI build without the `stable-order` patch must fail it",
      "notes": "The 1,000-body, 50-character, 10-vehicle scene, the AMD and Intel runs, the FBW hash and the slope-creep clause are RT-03's Phase 1 scope",
      "status": "partial",
      "tests": [
        {"doctest": "physics_tests", "case": "determinism: the scripted scene matches its golden hash (RT-03 Phase 0)"},
        {"doctest": "physics_tests", "case": "determinism: the golden holds at 1, 2, 4 and 16 workers"},
        {"doctest": "physics_tests", "case": "determinism: repeated runs in one process are identical"},
        {"doctest": "physics_tests", "case": "determinism: permuted BodyIDs give the same result when no island has two contacts"}
      ],
      "gaps": [
        {"clause": "Permuted variant: multi-contact islands diverge until third_party/jolt/patches/stable-order is vendored; when it lands, a CI build without the patch must also fail the variant (the negative control)", "state": "failing", "owner": "WP-0.9",
         "pinned_by": {"doctest": "physics_tests", "case": "determinism: KNOWN DIVERGENCE: permuted BodyIDs change multi-contact islands (stable-order patch pending)"}},
        {"clause": "MinGW: the cross-built binaries are never executed, so the hash is not checked on MinGW", "state": "unmeasured", "owner": "WP-0.1"}
      ]
    },
    {
      "id": "RT-13", "phase": 0, "source": "02 §8.2", "owner": "WP-0.10",
      "title": "Script kills, sticky kills, clean unwinding, no involuntary yields, StaleHandle, heap caps, 10k coroutines (all but the Phase 1 binding-heavy case)",
      "class": "N", "platforms": ["linux", "windows"],
      "threshold": "Runaway killed at `fuel_kill` on cells (replay kills at the identical fuel count) and ≤ 5 ms wall on the client; `pcall` cannot swallow a kill. A kill inside a metamethod, inside a `table.sort` comparator and inside a Luau callback invoked from C++ unwinds cleanly: ASan-clean, no engine lock held, VM usable afterwards. An instrumented `lua_yield` shows no yield except at explicit calls, including when budgets run out inside those three places. A handle whose entity is destroyed across a `wait` raises `StaleHandle`. Heap caps; 10k coroutines per zone. […] Fuel counts are identical between interpreter and codegen",
      "notes": "The binding-heavy case (Ph1, WP-1.6) is elided. The replay clause is evidenced by re-running (identical output and fuel across runs); the 04 §10.2 replay itself comes later. The ≤ 10 % overhead is 02 §7.4's, closed with RT-13 by WP-0.10r",
      "status": "partial",
      "tests": [
        {"doctest": "script_tests", "case": "fuel: a runaway loop is killed at exactly fuel_kill and the VM stays usable"},
        {"doctest": "script_tests", "case": "fuel: client profile kills at the wall-time budget and still counts fuel"},
        {"doctest": "script_tests", "case": "fuel: pcall, xpcall and nested coroutines cannot swallow a kill (sticky)"},
        {"doctest": "script_tests", "case": "fuel: kill inside a metamethod unwinds cleanly"},
        {"doctest": "script_tests", "case": "fuel: kill inside a table.sort comparator unwinds cleanly"},
        {"doctest": "script_tests", "case": "fuel: kill inside a Luau callback invoked from C++ releases RAII state and locks"},
        {"doctest": "script_tests", "case": "fuel: kill inside a metamethod unwinds cleanly", "run": "linux-asan"},
        {"doctest": "script_tests", "case": "fuel: kill inside a table.sort comparator unwinds cleanly", "run": "linux-asan"},
        {"doctest": "script_tests", "case": "fuel: kill inside a Luau callback invoked from C++ releases RAII state and locks", "run": "linux-asan"},
        {"doctest": "script_tests", "case": "fuel: no involuntary yields — every yield is an explicit call (instrumented)"},
        {"doctest": "script_tests", "case": "handles: a handle invalidated across a wait raises StaleHandle"},
        {"doctest": "script_tests", "case": "memory: exceeding the VM heap cap raises a memory error and the VM recovers"},
        {"doctest": "script_tests", "case": "scheduler: 10k coroutines per zone fit a 16 MB VM heap"},
        {"doctest": "script_tests", "case": "determinism: a pure script gives identical output and fuel across runs"},
        {"doctest": "script_tests", "case": "determinism: native codegen counts the same fuel as the interpreter"}
      ],
      "gaps": [
        {"clause": "Fuel counts differ between interpreter and native codegen for numeric for loops left by break or return (patch codegen-fornloop-fuel)", "state": "failing", "owner": "WP-0.10r",
         "pinned_by": {"doctest": "script_tests", "case": "determinism: known codegen divergence — numeric for loops left early"}},
        {"clause": "Fuel metering overhead ≤ 10 % on the perf workload (02 §7.4; measured ≈ 12–15 % without the fuel-counter patch)", "state": "failing", "owner": "WP-0.10r"}
      ]
    },
    {
      "id": "RT-18", "phase": 0, "source": "02 §8.2", "owner": "WP-0.6c",
      "title": "Link-model spike: a game DLL survives 100 reloads on 10k live entities",
      "class": "N+H", "platforms": ["linux", "windows"],
      "threshold": "A game-DLL component on 10k live entities survives 100 reloads (code-only, add-field and remove-field edits) with an identical values checksum, memory tags back to baseline, and the old image unmapped. A CVar, a system, an observer, a Luau binding and a Tracy zone from the DLL all work after every reload. ASan is clean with MSVC and Clang. The DLL passes §1.4's symbol audit. The edit-to-reload time is ≤ 30 s p95 on DEV",
      "notes": "N+H: the reload soak runs nightly; the edit-to-reload time is measured on DEV hardware (01 §3.1)",
      "status": "unmeasured",
      "tests": [],
      "gaps": [
