      "id": "BE-A1", "phase": 0, "source": "05 §10", "owner": "WP-0.15",
      "title": "helios-backend.exe run on Windows 11: warm start, first run and idle RSS",
      "class": "N+H", "platforms": ["windows"],
      "threshold": "`helios-backend.exe run` on Windows 11: warm start ≤ 5 s, first run ≤ 30 s (PG binaries cached), idle RSS incl. Postgres ≤ 500 MB",
      "notes": "N+H: the integration tests show the backend runs on hosted Windows (Windows Server); the timings are for a Windows 11 machine",
      "status": "partial",
