namespace sample::ship {

::helios::Result<::helios::u32> bindShipQueries(::helios::script::Binder& binder, ShipQueries& impl, std::string_view realm) {
    if (auto ok = checkRealm(binder, realm); !ok) return ok.error();
    nameIdTags(binder.state());
    ::helios::u32 count = 0;
    if (realm == "server" || realm == "client") {
        binder.function("ShipQueries", "hullOf", &glue_ShipQueries_hullOf, ::helios::script::FuelCost{4u, 0u, 0}, &impl);
        ++count;
    }
    if (realm == "server" || realm == "client") {
        binder.function("ShipQueries", "dockedShips", &glue_ShipQueries_dockedShips, ::helios::script::FuelCost{10u, 0u, 0}, &impl);
        ++count;
    }
    return count;
}

} // namespace sample::ship
