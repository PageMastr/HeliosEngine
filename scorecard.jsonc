    {
      "id": "NS-0.4", "phase": 0, "source": "04 §11.4", "owner": "WP-0.13",
      "title": "Fuzzers 1 h clean",
      "class": "N", "platforms": ["linux", "windows"],
      "threshold": "Each engine/net fuzz target runs 1 h under libFuzzer with ASan and UBSan with no crash, leak or timeout",
      "status": "partial",
      "tests": [
        {"gate": "libfuzzer_packet_parser", "platforms": ["linux"]},
        {"gate": "libfuzzer_connection_receive", "platforms": ["linux"]},
        {"gate": "libfuzzer_connect_token", "platforms": ["linux"]},
        {"gate": "libfuzzer_server_datagram", "platforms": ["linux"]},
        {"gate": "libfuzzer_address_parse", "platforms": ["linux"]}
      ],
      "gaps": [
        {"clause": "No Windows libFuzzer run: engine/net links -fsanitize=fuzzer through the compiler driver, which the clang-cl build (lld-link) does not use", "state": "unmeasured", "owner": "WP-0.13"}
