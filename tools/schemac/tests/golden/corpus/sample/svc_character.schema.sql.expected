CREATE SCHEMA IF NOT EXISTS svc_character;

-- sample.ship.HangarSlot (lock id 2194061890): A pilot's hangar slot, stored by the character service in its own PostgreSQL table (`--emit sql`,
CREATE TABLE svc_character.hangar_slot (
    owner BIGINT NOT NULL CONSTRAINT hangar_slot_owner_check CHECK (owner >= 0),
    slot INTEGER NOT NULL CONSTRAINT hangar_slot_slot_check CHECK (slot BETWEEN 0 AND 65535),
    ship BIGINT NOT NULL DEFAULT 0 CONSTRAINT hangar_slot_ship_check CHECK (ship >= 0),
    hull BIGINT NOT NULL DEFAULT 0 CONSTRAINT hangar_slot_hull_check CHECK (hull >= 0),
    size SMALLINT NOT NULL DEFAULT 1 CONSTRAINT hangar_slot_size_check CHECK (size BETWEEN 0 AND 255),
    label TEXT,
    damage JSONB CONSTRAINT hangar_slot_damage_check CHECK (jsonb_typeof(damage) = 'object'), -- canonical JSONC; NULL = the field's default
    stored_at BIGINT NOT NULL DEFAULT 0 CONSTRAINT hangar_slot_stored_at_check CHECK (stored_at >= 0),
    PRIMARY KEY (owner, slot)
);
