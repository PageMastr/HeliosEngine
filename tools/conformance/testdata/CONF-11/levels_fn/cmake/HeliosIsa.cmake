# WP-0.2r's natural shape: today's flag function (verbatim) fills 02 §1.1's level set at file scope, a
# helper caches a copy through another function defined after it, and one function applies a level.
function(helios_isa_avx2_flags out)
  if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    set(flags /arch:AVX2 /fp:precise)
  elseif(MSVC) # clang-cl
    set(flags /arch:AVX2 -mbmi -mbmi2 -mlzcnt -mpopcnt -mf16c -mno-fma /clang:-ffp-contract=off)
  else()
    set(flags -mavx2 -mbmi -mbmi2 -mlzcnt -mpopcnt -mf16c -mno-fma -mfpmath=sse -ffp-contract=off)
  endif()
  set(${out} "${flags}" PARENT_SCOPE)
endfunction()
helios_isa_avx2_flags(HELIOS_ISA_AVX2)
function(_helios_define_levels)
  _helios_level_flags(avx2 _l)
  set(HELIOS_ISA_AVX2_CACHED "${_l}" CACHE INTERNAL "")
endfunction()
function(_helios_level_flags level out)
  helios_isa_avx2_flags(_f)
  set(${out} ${_f} PARENT_SCOPE)
endfunction()
_helios_define_levels()
function(helios_apply_isa_level target level)
  target_compile_options(${target} PRIVATE ${HELIOS_ISA_AVX2})
endfunction()
