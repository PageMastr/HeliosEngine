{
  "description": "Comparisons (IEEE: NaN compares false, != true; -0 == +0), boolean operators, select, and laziness: untaken branches never read inputs (a missing input there is not an error).",
  "cases": [
    { "name": "logic.true", "src": "true", "bytecode": "6901c343685f6ff2", "type": "bool", "expect": true },
    { "name": "logic.false", "src": "false", "bytecode": "6901c443685f71a5", "type": "bool", "expect": false },
    { "name": "logic.lt", "src": "1 < 2", "bytecode": "c0a90ffe276735f3", "expect": true },
    { "name": "logic.lt_equal", "src": "2 < 2", "bytecode": "8226a447397fe0fe", "expect": false },
    { "name": "logic.le", "src": "2 <= 2", "bytecode": "8226a547397fe2b1", "expect": true },
    { "name": "logic.gt", "src": "3 > 2", "bytecode": "56a69647650a6116", "expect": true },
    { "name": "logic.ge", "src": "1 >= 2", "bytecode": "c0a910fe276737a6", "expect": false },
    { "name": "logic.eq", "src": "0.5 == 1 / 2", "bytecode": "c61c754ea84874e9", "expect": true },
    { "name": "logic.ne", "src": "0.1 + 0.2 != 0.3", "bytecode": "6483ed6d4ebcd256", "expect": true },
    { "name": "logic.neg_zero_eq_zero", "src": "-0 == 0", "bytecode": "f2537ea20d3e02d2", "expect": true },
    { "name": "logic.neg_zero_lt_zero", "src": "-0 < 0", "bytecode": "f2537aa20d3dfc06", "expect": false },
    { "name": "logic.nan_eq", "src": "0/0 == 0/0", "bytecode": "f5c75ea64e48f941", "expect": false },
    { "name": "logic.nan_ne", "src": "0/0 != 0/0", "bytecode": "f5c75da64e48f78e", "expect": true },
    { "name": "logic.nan_lt", "src": "0/0 < 1", "bytecode": "94c8e2027a0c4250", "expect": false },
    { "name": "logic.nan_ge", "src": "0/0 >= 1", "bytecode": "94c8e5027a0c4769", "expect": false },
    { "name": "logic.inf_gt", "src": "1/0 > 1e308", "bytecode": "a081f2ed89a44b32", "expect": true },
    { "name": "logic.bool_eq", "src": "(1 < 2) == true", "bytecode": "61ba12569b720833", "expect": true },
    { "name": "logic.bool_ne", "src": "true != false", "bytecode": "f991780dda00fdab", "expect": true },
    { "name": "logic.eq_left_assoc", "src": "1 == 1 == true", "bytecode": "95d8d695b30630d9", "expect": true },
    { "name": "logic.compare_precedence", "src": "1 + 1 < 3 == 2 * 2 > 3", "bytecode": "ef4338a7f714ad9c", "expect": true },
    { "name": "logic.not", "src": "!true", "bytecode": "e773d4d7adca3ef0", "expect": false },
    { "name": "logic.not_not", "src": "!!true", "bytecode": "57c7481a5385a2ae", "expect": true },
    { "name": "logic.not_compare", "src": "!(1 > 2)", "bytecode": "073d165464c432a5", "expect": true },
    { "name": "logic.and_tt", "src": "true && true", "bytecode": "74a1e84d66b6705f", "expect": true },
    { "name": "logic.and_tf", "src": "true && false", "bytecode": "5558633c268c1310", "expect": false },
    { "name": "logic.and_ft", "src": "false && true", "bytecode": "d969d99a58b5e740", "expect": false },
    { "name": "logic.or_ff", "src": "false || false", "bytecode": "d969d99a58b5e740", "expect": false },
    { "name": "logic.or_ft", "src": "false || true", "bytecode": "d969da9a58b5e8f3", "expect": true },
    { "name": "logic.or_tf", "src": "true || false", "bytecode": "74a1e84d66b6705f", "expect": true },
    { "name": "logic.and_binds_tighter", "src": "true || false && false", "bytecode": "1890429765f17e11", "expect": true },
    { "name": "logic.and_binds_tighter_2", "src": "false && false || true", "bytecode": "bd029bceda1334fd", "expect": true },
    { "name": "logic.select_true", "src": "select(1 < 2, 10, 20)", "bytecode": "e66d2bb35e6c1e99", "expect": 10 },
    { "name": "logic.select_false", "src": "select(1 > 2, 10, 20)", "bytecode": "746ef646e7e7e15b", "expect": 20 },
    { "name": "logic.select_bool", "src": "select(true, false, true)", "bytecode": "5558643c268c14c3", "type": "bool", "expect": false },
    { "name": "logic.select_nested", "src": "select(false, 1, select(true, 2, 3))", "bytecode": "c86a8a2631102276", "expect": 2 },
    { "name": "logic.select_nan_branch", "src": "select(0/0 == 0/0, 1, 2)", "bytecode": "0fc826060637398a", "expect": 2 },
    { "name": "logic.lazy_select_then", "src": "select(true, 5, attr(self, Missing))", "bytecode": "c6a0f38577d2d58a", "expect": 5 },
    { "name": "logic.lazy_select_else", "src": "select(false, attr(self, Missing), 6)", "bytecode": "499f44e4d77f3e4f", "expect": 6 },
    { "name": "logic.lazy_select_reads_taken", "src": "select(false, 5, attr(self, Missing))", "bytecode": "353ca53464d25247", "evalError": "E_MISSING_INPUT" },
    { "name": "logic.lazy_and", "src": "false && attr(self, Missing) > 0", "bytecode": "662ceeb4e0a7c294", "expect": false },
    { "name": "logic.lazy_or", "src": "true || tag(nobody, Anything)", "params": ["self", "nobody"], "bytecode": "54a723ce8eb8748d", "expect": true },
    { "name": "logic.and_reads_rhs", "src": "true && attr(self, Missing) > 0", "bytecode": "8322e57fa759afdd", "evalError": "E_MISSING_INPUT" },
    { "name": "logic.or_reads_rhs", "src": "false || attr(self, Missing) > 0", "bytecode": "a1828c5524e79cf9", "evalError": "E_MISSING_INPUT" },
    { "name": "logic.mixed_chain", "src": "(1 < 2 && 2 < 3) || (3 < 2 && 0/0 == 0)", "bytecode": "94794d09e0b5c6d5", "expect": true },
    { "name": "logic.select_in_arith", "src": "1 + select(2 > 1, 10, 100) * 2", "bytecode": "7582eea1a7681b7e", "expect": 21 },
    { "name": "logic.expect_bool", "src": "1 < 2", "expectType": "bool", "bytecode": "c0a90ffe276735f3", "expect": true },
    { "name": "logic.expect_num", "src": "select(true, 1, 2)", "expectType": "num", "bytecode": "cb3fbdec312482db", "expect": 1 }
  ]
}
