// Helios editor theme: high contrast (07 §4.3). Text/background pairs must reach 7:1 (WCAG 2.2
// AAA); frames carry borders and focus uses a thick yellow outline, so state never depends on
// color alone.
{
  "name": "high-contrast",
  "highContrast": true,
  "colors": {
    "text": "#FFFFFF",
    "textDisabled": "#C8C8C8",
    "windowBg": "#000000",
    "childBg": "#000000",
    "popupBg": "#000000",
    "border": "#FFFFFF",
    "frameBg": "#000000",
    "frameBgHovered": "#1A1A40",
    "frameBgActive": "#2A2A60",
    "titleBg": "#000000",
    "titleBgActive": "#101030",
    "menuBarBg": "#000000",
    "scrollbarBg": "#000000",
    "scrollbarGrab": "#FFFFFF",
    "checkMark": "#FFE600",
    "sliderGrab": "#FFE600",
    "button": "#00007A",
    "buttonHovered": "#1A1A99",
    "buttonActive": "#000055",
    "header": "#00005E",
    "headerHovered": "#20208A",
    "headerActive": "#000044",
    "separator": "#FFFFFF",
    "tab": "#000000",
    "tabHovered": "#20208A",
    "tabSelected": "#00005E",
    "tabDimmed": "#000000",
    "tabDimmedSelected": "#1A1A40",
    "dockingPreview": "#FFE60066",
    "tableHeaderBg": "#101030",
    "tableRowBgAlt": "#FFFFFF10",
    "textSelectedBg": "#FFE60066",
    "navHighlight": "#FFE600",
    "statusBarBg": "#000000",
    "accentLocal": "#FFFFFF",
    "accentShared": "#FFB000",
    "accentLive": "#FF4040",
    "badgeServer": "#FFB000",
    "badgeClient": "#7CFF7C",
    "dirty": "#FFE600",
    "error": "#FF8080",
    "viewportBg": "#101010",
    "viewportGrid": "#505050"
  },
  "metrics": {
    "fontSize": 15,
    "windowRounding": 0,
    "frameRounding": 0,
    "tabRounding": 0,
    "windowBorderSize": 1,
    "frameBorderSize": 1,
    "framePaddingX": 6,
    "framePaddingY": 3,
    "itemSpacingX": 8,
    "itemSpacingY": 4
  }
}
