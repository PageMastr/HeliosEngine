        {"go": "pkg/hxl", "test": "TestCorpusAtGOAMD64v3"},
        {"go": "pkg/hxl", "test": "TestNoFusedMultiplyAddInMachineCode"},
        {"go": "pkg/hxl/hxlfloat", "test": "TestHXLPackagesClean"},
        {"go": "pkg/hxl/hxlfloat", "test": "TestPlantedViolations"}
      ],
      "gaps": [
        {"clause": "linux/arm64: no runner runs the corpus there; only the arm64 machine-code listing is checked (TestNoFusedMultiplyAddInMachineCode)", "state": "unmeasured", "owner": "WP-0.1"}
      ]
    }
