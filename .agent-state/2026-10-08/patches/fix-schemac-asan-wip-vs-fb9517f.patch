 else()
-  set(pg_host "${WORK_DIR}")
-  set(server_options "-k ${WORK_DIR} -c listen_addresses= -p ${port}")
+  make_socket_dir(socket_dir)
+  if(run_as)
+    execute_process(COMMAND chown nobody "${socket_dir}")
+  endif()
+  set(pg_host "${socket_dir}")
+  set(server_options "-k ${socket_dir} -c listen_addresses= -p ${port}")
 endif()
 set(errors "")
 
