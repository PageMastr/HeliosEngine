{
  "description": "Float edge cases: subnormal inputs and results, gradual underflow, overflow, round-half-even ties, catastrophic cancellation and non-associativity. Inputs come in through context fields because HXL literals must be zero or normal.",
  "cases": [
    { "name": "edge.subnormal_input", "src": "v.x", "params": ["v"], "bytecode": "6fc3e393015b7761",
      "inputs": { "fields": { "v": { "x": "0x1p-1074" } } }, "expect": "0x1p-1074" },
    { "name": "edge.subnormal_add", "src": "v.x + v.x", "params": ["v"], "bytecode": "05f50ca16744a3b4",
      "inputs": { "fields": { "v": { "x": "0x1p-1074" } } }, "expect": "0x1p-1073" },
    { "name": "edge.subnormal_half", "src": "v.x / 2", "params": ["v"], "bytecode": "5f2740755165002c",
      "inputs": { "fields": { "v": { "x": "0x1p-1074" } } }, "expect": 0,
      "comment": "exact tie between 0 and 2^-1074: rounds to even (0)" },
    { "name": "edge.subnormal_three_halves", "src": "v.x * 1.5", "params": ["v"], "bytecode": "0325a047a0d5e76a",
      "inputs": { "fields": { "v": { "x": "0x1p-1074" } } }, "expect": "0x1p-1073",
      "comment": "1.5 ulp rounds to even (2 ulp)" },
    { "name": "edge.gradual_underflow", "src": "2.2250738585072014e-308 / 4", "bytecode": "7d7eaa694be5acc3", "expect": "0x0.4p-1022" },
    { "name": "edge.underflow_to_zero", "src": "1e-300 * 1e-300", "bytecode": "639b8f3839f9a0e7", "expect": 0 },
    { "name": "edge.underflow_neg_zero", "src": "-1e-300 * 1e-300", "bytecode": "bc69d3170f9527c3", "expect": "-0" },
    { "name": "edge.subnormal_mul", "src": "1e-160 * 1e-160", "bytecode": "df0b564e716aa0c7", "expect": "0x1.fap-1064" },
    { "name": "edge.subnormal_sqrt", "src": "sqrt(v.x)", "params": ["v"], "bytecode": "1b4506914fc61964",
      "inputs": { "fields": { "v": { "x": "0x1p-1074" } } }, "expect": "0x1p-537" },
    { "name": "edge.max_minus_ulp", "src": "v.x - v.y", "params": ["v"], "bytecode": "d468fcb34698789f",
      "inputs": { "fields": { "v": { "x": "0x1.fffffffffffffp+1023", "y": "0x1p+970" } } }, "expect": "0x1.ffffffffffffep+1023" },
    { "name": "edge.tie_to_even_up", "src": "1 + v.x", "params": ["v"], "bytecode": "0ed86ba42acb4fbe",
      "inputs": { "fields": { "v": { "x": "0x1.8p-52" } } }, "expect": "0x1.0000000000002p+0",
      "comment": "1 + 1.5 ulp: tie between 1+1ulp (odd) and 1+2ulp (even)" },
    { "name": "edge.tie_to_even_down", "src": "1 + v.x", "params": ["v"], "bytecode": "0ed86ba42acb4fbe",
      "inputs": { "fields": { "v": { "x": "0x1p-53" } } }, "expect": 1,
      "comment": "1 + half ulp rounds to even (1)" },
    { "name": "edge.just_above_tie", "src": "1 + v.x", "params": ["v"], "bytecode": "0ed86ba42acb4fbe",
      "inputs": { "fields": { "v": { "x": "0x1.0000000000001p-53" } } }, "expect": "0x1.0000000000001p+0" },
    { "name": "edge.cancellation", "src": "(v.x + 1) - v.x", "params": ["v"], "bytecode": "823e1dfad9b04be9",
      "inputs": { "fields": { "v": { "x": "10000000000000002" } } }, "expect": 2,
      "comment": "x + 1 is a tie that rounds to the even neighbour x + 2; never reassociated to 1" },
    { "name": "edge.absorption", "src": "(v.x + 1) - v.x", "params": ["v"], "bytecode": "823e1dfad9b04be9",
      "inputs": { "fields": { "v": { "x": "1e17" } } }, "expect": 0 },
    { "name": "edge.sum_order_matters", "src": "v.a + v.b + v.c", "params": ["v"], "bytecode": "0eb5f196d578bd47",
      "inputs": { "fields": { "v": { "a": "1e308", "b": "1e308", "c": "-1e308" } } }, "expect": "inf" },
    { "name": "edge.sum_order_matters_2", "src": "v.a + (v.b + v.c)", "params": ["v"], "bytecode": "5ae832bc31418952",
      "inputs": { "fields": { "v": { "a": "1e308", "b": "1e308", "c": "-1e308" } } }, "expect": "1e308" },
    { "name": "edge.product_order", "src": "v.a * v.b * v.c", "params": ["v"], "bytecode": "ea8883fcc4fc0a9f",
      "inputs": { "fields": { "v": { "a": "1e-200", "b": "1e-200", "c": "1e200" } } }, "expect": 0 },
    { "name": "edge.product_order_2", "src": "v.a * (v.b * v.c)", "params": ["v"], "bytecode": "5aef00bc3147530a",
      "inputs": { "fields": { "v": { "a": "1e-200", "b": "1e-200", "c": "1e200" } } }, "expect": "0x1.87e92154ef7acp-665" },
    { "name": "edge.nan_input_canonical", "src": "v.x", "params": ["v"], "bytecode": "6fc3e393015b7761",
      "inputs": { "fields": { "v": { "x": "nan" } } }, "expect": "nan" },
    { "name": "edge.inf_input", "src": "v.x * -1", "params": ["v"], "bytecode": "2816be676fec1522",
      "inputs": { "fields": { "v": { "x": "inf" } } }, "expect": "-inf" },
    { "name": "edge.neg_zero_input", "src": "v.x * 2", "params": ["v"], "bytecode": "5f273f755164fe79",
      "inputs": { "fields": { "v": { "x": "-0" } } }, "expect": "-0" },
    { "name": "edge.division_exact", "src": "v.x / v.y", "params": ["v"], "bytecode": "d468fab346987539",
      "rows": { "fields": ["x", "y"], "data": [
        ["1", "3", "0x1.5555555555555p-02"], ["2", "3", "0x1.5555555555555p-01"], ["1", "7", "0x1.2492492492492p-03"], ["22", "7", "0x1.9249249249249p+01"], ["1e308", "1e-10", "inf"],
        ["1e-307", "1e10", "0x1.ee257p-1054"], ["-5", "0x1p-1074", "-inf"], ["0x1p-1074", "2", 0], ["0x1p-1073", "2", "0x1p-1074"]
      ] } },
    { "name": "edge.mul_rounding", "src": "v.x * v.y", "params": ["v"], "bytecode": "d468fbb3469876ec",
      "rows": { "fields": ["x", "y"], "data": [
        ["0.1", "0.1", "0x1.47ae147ae147cp-07"], ["1.1", "1.1", "0x1.35c28f5c28f5dp+00"], ["3.3", "3", "0x1.3ccccccccccccp+03"], ["1e154", "1e154", "0x1.1ccf385ebc8ap+1023"], ["1e-154", "1e-154", "0x1.cc359e067a348p-1024"],
        ["0x1.fffffffffffffp+0", "0x1.fffffffffffffp+0", "0x1.ffffffffffffep+01"], ["0x1.0000000000001p+0", "0x1.0000000000001p+0", "0x1.0000000000002p+00"]
      ] } },
    { "name": "edge.compare_subnormal", "src": "v.x > 0 && -v.x < 0 && v.x / 2 == 0", "params": ["v"], "bytecode": "c24a81407d35a17b",
      "inputs": { "fields": { "v": { "x": "0x1p-1074" } } }, "expect": true }
  ]
}
