{
  "description": "min, max, clamp, lerp, abs, floor, ceil, sqrt: exact IEEE operations plus HXL's NaN (propagating, canonical) and signed-zero (-0 < +0) rules.",
  "cases": [
    { "name": "builtins.min2", "src": "min(3, 1)", "bytecode": "3c925b6630ccd7de", "expect": 1 },
    { "name": "builtins.min_many", "src": "min(3, 1, 2, -4, 5)", "bytecode": "cabf8306ad517fef", "expect": -4 },
    { "name": "builtins.max2", "src": "max(3, 1)", "bytecode": "3c925c6630ccd991", "expect": 3 },
    { "name": "builtins.max_many", "src": "max(-3, -1, -2)", "bytecode": "68946bd8afeec006", "expect": -1 },
    { "name": "builtins.min_zero_signs", "src": "min(0, -0)", "bytecode": "b2d2d91cc99b5357", "expect": "-0" },
    { "name": "builtins.min_zero_signs_2", "src": "min(-0, 0)", "bytecode": "7afa0b52cd5cc5f9", "expect": "-0" },
    { "name": "builtins.max_zero_signs", "src": "max(-0, 0)", "bytecode": "7afa0a52cd5cc446", "expect": 0 },
    { "name": "builtins.max_zero_signs_2", "src": "max(0, -0)", "bytecode": "b2d2d81cc99b51a4", "expect": 0 },
    { "name": "builtins.min_nan_left", "src": "min(0/0, 1)", "bytecode": "8c22d34336cb6d99", "expect": "nan" },
    { "name": "builtins.min_nan_right", "src": "min(1, 0/0)", "bytecode": "5590afa87641661b", "expect": "nan" },
    { "name": "builtins.max_nan", "src": "max(1/0, 0/0)", "bytecode": "cc797db4fa0d3068", "expect": "nan" },
    { "name": "builtins.min_inf", "src": "min(-1/0, -1e308)", "bytecode": "a85c6f6a57d7d37b", "expect": "-inf" },
    { "name": "builtins.max_inf", "src": "max(1/0, 1e308)", "bytecode": "d5f5ee204bd008c6", "expect": "inf" },
    { "name": "builtins.clamp_inside", "src": "clamp(0.5, 0, 1)", "bytecode": "1f3494d911b9f748", "expect": 0.5 },
    { "name": "builtins.clamp_low", "src": "clamp(-5, 0, 1)", "bytecode": "82fcc9424df7c25f", "expect": 0 },
    { "name": "builtins.clamp_high", "src": "clamp(5, 0, 1)", "bytecode": "a1d6df889ad7c235", "expect": 1 },
    { "name": "builtins.clamp_inverted", "src": "clamp(0.5, 2, 1)", "bytecode": "7fe0416a7b33e688", "expect": 1,
      "comment": "min(max(x, lo), hi): hi wins when lo > hi" },
    { "name": "builtins.clamp_nan_x", "src": "clamp(0/0, 0, 1)", "bytecode": "34d5bbc8a466958d", "expect": "nan" },
    { "name": "builtins.clamp_nan_bound", "src": "clamp(0.5, 0/0, 1)", "bytecode": "20855191ac62ba40", "expect": "nan" },
    { "name": "builtins.clamp_neg_zero", "src": "clamp(-0, 0, 1)", "bytecode": "9820f7aca9ff38a4", "expect": 0 },
    { "name": "builtins.lerp_mid", "src": "lerp(2, 4, 0.5)", "bytecode": "6c2e18d73f9b94e6", "expect": 3 },
    { "name": "builtins.lerp_ends", "src": "lerp(2, 4, 0) + lerp(2, 4, 1)", "bytecode": "5b09055c663ad613", "expect": 6 },
    { "name": "builtins.lerp_extrapolate", "src": "lerp(0, 10, 1.5)", "bytecode": "7c199da35d03af1a", "expect": 15 },
    { "name": "builtins.lerp_rounding", "src": "lerp(0.1, 0.7, 0.3)", "bytecode": "6d9a1e836cd6cfd1", "expect": "0x1.1eb851eb851ecp-02",
      "comment": "a + (b - a) * t with one rounding per op" },
    { "name": "builtins.lerp_not_exact_at_one", "src": "lerp(0.1, 0.7, 1)", "bytecode": "33a86b610247bb4c", "expect": "0x1.6666666666666p-01",
      "comment": "the formula need not return b exactly at t = 1; it must return the same bits everywhere" },
    { "name": "builtins.lerp_inf", "src": "lerp(0, 1/0, 0)", "bytecode": "c4ea97dacef84526", "expect": "nan", "comment": "inf * 0" },
    { "name": "builtins.abs_neg", "src": "abs(-2.5)", "bytecode": "de55ef65b1dcc77f", "expect": 2.5 },
    { "name": "builtins.abs_neg_zero", "src": "abs(-0)", "bytecode": "2e93ee1f2dfbe573", "expect": 0 },
    { "name": "builtins.abs_inf", "src": "abs(-1/0)", "bytecode": "5a64f34c163f19e6", "expect": "inf" },
    { "name": "builtins.abs_nan", "src": "abs(0/0)", "bytecode": "b2e0911cc9a7165b", "expect": "nan" },
    { "name": "builtins.floor_pos", "src": "floor(2.7)", "bytecode": "bb0f6734a0f50340", "expect": 2 },
    { "name": "builtins.floor_neg", "src": "floor(-2.2)", "bytecode": "b0bc321db52b60e8", "expect": -3 },
    { "name": "builtins.floor_neg_half", "src": "floor(-0.5)", "bytecode": "23c4cee432e0728b", "expect": -1 },
    { "name": "builtins.floor_neg_zero", "src": "floor(-0)", "bytecode": "2e93ed1f2dfbe3c0", "expect": "-0" },
    { "name": "builtins.floor_big", "src": "floor(2251799813685248.5)", "bytecode": "015a6d76b1d14b24", "expect": 2251799813685248 },
    { "name": "builtins.floor_huge", "src": "floor(1e300)", "bytecode": "252a3b29f86880c6", "expect": "0x1.7e43c8800759cp+996" },
    { "name": "builtins.ceil_pos", "src": "ceil(2.2)", "bytecode": "97933a39aaf1f969", "expect": 3 },
    { "name": "builtins.ceil_neg", "src": "ceil(-2.7)", "bytecode": "60dbe1adad4bdaf9", "expect": -2 },
    { "name": "builtins.ceil_neg_half", "src": "ceil(-0.5)", "bytecode": "23c4fbe432e0bf02", "expect": "-0" },
    { "name": "builtins.ceil_tiny", "src": "ceil(1e-300)", "bytecode": "dd77d97dd8acc3fc", "expect": 1 },
    { "name": "builtins.ceil_inf", "src": "ceil(-1/0)", "bytecode": "5a652d4c163f7c74", "expect": "-inf" },
    { "name": "builtins.sqrt_4", "src": "sqrt(4)", "bytecode": "19e583a82cd3dd90", "expect": 2 },
    { "name": "builtins.sqrt_2", "src": "sqrt(2)", "bytecode": "85983dcf62a68a20", "expect": "0x1.6a09e667f3bcdp+0" },
    { "name": "builtins.sqrt_neg", "src": "sqrt(-1)", "bytecode": "854e54a757e02383", "expect": "nan" },
    { "name": "builtins.sqrt_neg_zero", "src": "sqrt(-0)", "bytecode": "6ae067b965c60590", "expect": "-0" },
    { "name": "builtins.sqrt_inf", "src": "sqrt(1/0)", "bytecode": "00beb8a1f55440af", "expect": "inf" },
    { "name": "builtins.sqrt_max", "src": "sqrt(1.7976931348623157e308)", "bytecode": "0096a9e1cc9fbaf8", "expect": "0x1.fffffffffffffp+511" },
    { "name": "builtins.sqrt_min_normal", "src": "sqrt(2.2250738585072014e-308)", "bytecode": "cfb681c362e17a50", "expect": "0x1p-511" },
    { "name": "builtins.sqrt_0_01", "src": "sqrt(0.01)", "bytecode": "bab2794f4d755646", "expect": "0x1.999999999999ap-4" },
    { "name": "builtins.nested", "src": "max(min(abs(-3), ceil(2.5)), floor(sqrt(8)))", "bytecode": "f4a4ff5a3642a60c", "expect": 3 },
    { "name": "builtins.sqrt_sweep", "src": "sqrt(v.x)", "params": ["v"], "bytecode": "1b4506914fc61964",
      "rows": { "fields": ["x"], "data": [
        ["0.5", "0x1.6a09e667f3bcdp-01"], ["3", "0x1.bb67ae8584caap+00"], ["10", "0x1.94c583ada5b53p+01"], ["1e-300", "0x1.a2fe76a3f9475p-499"], ["123456789.123", "0x1.5b38e3769e551p+13"], ["0x1.fffffffffffffp+0", "0x1.6a09e667f3bccp+00"],
        ["0x1.0000000000001p+0", 1], ["1e300", "0x1.38d352e5096afp+498"], ["7.389056098930650", "0x1.5bf0a8b145769p+01"], ["0x1p-1022", "0x1p-511"]
      ] } }
  ]
}
