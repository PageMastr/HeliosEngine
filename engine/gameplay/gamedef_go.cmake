# Keeps the committed Go twin of the gameplay kernel records (services/pkg/hxl/gamedef) equal to what
# helios-schemac generates from schemas/gameplay/*.hschema. The build generates into its own binary
# directory (engine/gameplay/CMakeLists.txt); nothing writes into the source tree except `sync`.
# 02 §3.5 and 05 §2.1: generated Go is committed and CI-checked.
#
#   cmake -DMODE=check -DGENERATED=<build>/engine/gameplay/go/gamedef -DCOMMITTED=<src>/services/pkg/hxl/gamedef
#         -DREFRESH="<command>" -P gamedef_go.cmake          # CTest lint_gamedef_go_current
#   cmake -DMODE=sync  -DGENERATED=... -DCOMMITTED=... -P gamedef_go.cmake
#                                                           # target gameplay_gamedef_sync
#   cmake -DMODE=check -DSEED_STALE=<work dir> -DGENERATED=... -P gamedef_go.cmake
#                                                           # seeded violation (must fail)
#
# Files compare up to line endings: Windows checkouts may turn the committed LF files into CRLF.

cmake_minimum_required(VERSION 3.28)
foreach(var MODE GENERATED)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "gamedef_go: pass -D${var}=...")
  endif()
endforeach()
if(NOT DEFINED REFRESH OR REFRESH STREQUAL "")
  set(REFRESH "cmake --build <build dir> --target gameplay_gamedef_sync")
endif()

file(GLOB generated RELATIVE "${GENERATED}" "${GENERATED}/*.go")
list(SORT generated)
if(generated STREQUAL "")
  message(FATAL_ERROR "gamedef_go: no generated Go files in ${GENERATED}; build helios_gameplay first")
endif()

if(DEFINED SEED_STALE)
  # Seeded violation for the lint's own fixture test: a copy of the generated files with one edit.
  file(REMOVE_RECURSE "${SEED_STALE}")
  file(MAKE_DIRECTORY "${SEED_STALE}")
  foreach(f IN LISTS generated)
    file(COPY_FILE "${GENERATED}/${f}" "${SEED_STALE}/${f}")
  endforeach()
  list(GET generated 0 victim)
  file(APPEND "${SEED_STALE}/${victim}" "// seeded stale edit\n")
  set(COMMITTED "${SEED_STALE}")
endif()
if(NOT DEFINED COMMITTED)
  message(FATAL_ERROR "gamedef_go: pass -DCOMMITTED=...")
endif()

function(_gamedef_read path out)
  file(READ "${path}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

file(GLOB committed RELATIVE "${COMMITTED}" "${COMMITTED}/*.go")
set(stale "")
set(missing "")
set(extra "")
foreach(f IN LISTS generated)
  if(NOT EXISTS "${COMMITTED}/${f}")
    list(APPEND missing "${f}")
    continue()
  endif()
  _gamedef_read("${GENERATED}/${f}" want)
  _gamedef_read("${COMMITTED}/${f}" have)
  if(NOT want STREQUAL have)
    list(APPEND stale "${f}")
  endif()
endforeach()
foreach(f IN LISTS committed)
  if(NOT f IN_LIST generated)
    list(APPEND extra "${f}")
  endif()
endforeach()

if(MODE STREQUAL "check")
  if(stale OR missing OR extra)
    set(report "")
    if(stale)
      string(APPEND report "\n  stale: ${stale}")
    endif()
    if(missing)
      string(APPEND report "\n  missing: ${missing}")
    endif()
    if(extra)
      string(APPEND report "\n  not generated (remove): ${extra}")
    endif()
    message(FATAL_ERROR "gamedef_go: ${COMMITTED} differs from helios-schemac's output in ${GENERATED}:${report}\n"
                        "Regenerate with: ${REFRESH}")
  endif()
  list(LENGTH generated n)
  message(STATUS "gamedef_go: ${n} committed files match helios-schemac's output")
elseif(MODE STREQUAL "sync")
  foreach(f IN LISTS stale missing)
    file(COPY_FILE "${GENERATED}/${f}" "${COMMITTED}/${f}")
    message(STATUS "gamedef_go: updated ${COMMITTED}/${f}")
  endforeach()
  foreach(f IN LISTS extra)
    file(STRINGS "${COMMITTED}/${f}" head LIMIT_COUNT 1)
    if(head MATCHES "^// Code generated by helios-schemac")
      file(REMOVE "${COMMITTED}/${f}")
      message(STATUS "gamedef_go: removed ${COMMITTED}/${f} (no longer generated)")
    else()
      message(WARNING "gamedef_go: ${COMMITTED}/${f} is not generated by helios-schemac; left in place")
    endif()
  endforeach()
  if(NOT stale AND NOT missing AND NOT extra)
    message(STATUS "gamedef_go: ${COMMITTED} is already current")
  endif()
else()
  message(FATAL_ERROR "gamedef_go: MODE must be check or sync, not '${MODE}'")
endif()
