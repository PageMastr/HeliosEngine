    lua_createtable(L, static_cast<int>(v.size()), 0);
    int n = 0;
    for (const auto& e : v) {
        push22(L, e, depth + 1);
        lua_rawseti(L, -2, ++n);
    }
}
std::vector<::helios::u32> check29(Ctx& c, int idx) {
    take(c, 1);
    const Nest nest(c);
    if (lua_type(c.L, idx) != LUA_TTABLE) badType(c, idx, "{number}");
    idx = lua_absindex(c.L, idx);
    const int n = lua_objlen(c.L, idx);
    reserve(c, n); // every element takes at least one value: fail before converting any
    std::vector<::helios::u32> out{};
    out.reserve(static_cast<usize>(n));
    for (int i = 1; i <= n; ++i) {
        lua_rawgeti(c.L, idx, i);
        out.push_back(check22(c, -1));
        lua_pop(c.L, 1);
    }
    return out;
}

// golden.all.Tagged
void push30(lua_State* L, const ::golden::all::Tagged& v, int depth) {
    enter(L, depth);
    lua_createtable(L, 0, 2);
    push31(L, v.label, depth + 1);
    lua_rawsetfield(L, -2, "label");
    if (v.names.size() > 3u) fail(L, std::format("result field 'Tagged.names' has {} elements or bytes; its @max is 3", v.names.size()));
    push32(L, v.names, depth + 1);
    lua_rawsetfield(L, -2, "names");
}

// Name (struct field)
void push31(lua_State* L, const ::helios::Name& v, int depth) {
    (void)depth;
    const std::string_view s = v.view();
    lua_pushlstring(L, s.data(), s.size());
}

// set<Name> (struct field)
void push32(lua_State* L, const std::set<::helios::Name>& v, int depth) {
    enter(L, depth);
    lua_createtable(L, static_cast<int>(v.size()), 0);
    int n = 0;
    std::vector<std::string_view> sorted;
    sorted.reserve(v.size());
    for (const auto& e : v) sorted.push_back(e.view());
    std::sort(sorted.begin(), sorted.end());
    for (const std::string_view e : sorted) {
        lua_pushlstring(L, e.data(), e.size());
        lua_rawseti(L, -2, ++n);
    }
}

