// Known-failing CONF findings (docs/plan/09-roadmap-and-process.md §5.10.2 D3; tools/conformance/README.md).
//
// Each record names a rule, the paths where it fails today, the rework WP that owns the fix (`owner`),
// the §5.10.4 row that records it (`anchor`) and why. helios-conformance reports those findings as
// "known failing, owned by <WP>" (SARIF: an external suppression) and does not fail on them. A record
// that matches no finding fails the run, so the rework WP that closes a gap removes its record and the
// scorecard gap (scorecard.jsonc, EXIT-0.conformance) in the same PR. `-strict` ignores this file.
// Adding a record is a Director decision (D3), made in the same round as the rework WP it names.
{
  "known_failing": [
    {
      "rule": "CONF-11", "owner": "WP-0.2r", "anchor": "09 §5.10.4 (b)",
      "reason": "The in-tree ISA code was written to the per-file AVX2 allowlist that the ADR-011 amendment retired: HELIOS_ISA_AVX2_TARGETS, HELIOS_ISA_AVX2_SOURCE_PATTERNS and helios_avx2_sources() (and their users in the ISA audit, its disassembly fixture and pcg), and tp_jolt's PUBLIC ISA options. WP-0.2r replaces them with whole-image levels (09 §2 WP-0.2r items 1-5)",
      "paths": ["cmake/HeliosIsa.cmake", "cmake/isa_allowlist.cmake", "tools/lint/isa_audit.cmake",
                "tools/lint/lint_tests.cmake", "engine/pcg/CMakeLists.txt", "third_party/CMakeLists.txt"]
    },
    {
      "rule": "CONF-12", "owner": "WP-0.5r", "anchor": "09 §5.10.4 (b)",
      "reason": "The Windows gate sits in .CRT$XIB, ends with ExitProcess, and has neither /INCLUDE:_tls_used nor helios_cpu_gate_tls_entry (its export is helios_cpu_gate_crt_entry). WP-0.5r moves it to .CRT$XLA0 with TerminateProcess(…, 78) and the three exports",
      "paths": ["engine/core/src/platform/win32/cpu_gate_hook.c"]
    }
  ]
