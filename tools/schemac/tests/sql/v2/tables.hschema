/// Release N+1: a rename, widenings (an enum's underlying type too), an optional, new columns (one with
/// control characters in its default), a removed field, a removed table and a new table.
package sqltest;

enum Tier : u16 { Bronze; Silver; Gold; Platinum = 300 }

struct Account @store(character) @sql(schema="svc_sqltest") {
  id:     u64 @key
  level:  u8 = 1 @was("rank")
  amount: i64
  small:  u16 = 3
  note:   string?
  tier:   Tier = Silver
  added:  bool = true
  tags:   TagSet
  pos:    vec3d = [0, 1, 0]
  banner: string = "one\n-- +goose ENVSUB ON\ttwo\u0001"
}

struct User @store(character) @sql(schema="svc_sqltest") @key(owner, order) {
  owner: EntityId
  order: u16
  when:  Duration = 2s
  label: LocString
}

struct Fresh @store(character) @sql(schema="svc_sqltest") {
  id:    Guid @key
  asset: AssetRef<Mesh>
  kinds: map<Name, list<u8>>
  ratio: f64 = 0.25
  path:  string = "C:\\data\\it's"
}
