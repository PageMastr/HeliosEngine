{
  "description": "Gameplay formulas from the plan, as data (R09-A0): EVE turret hit chance (06 §1.2), stacking penalties, missile damage, capacitor recharge (06 §8.5), industry durations and vendor prices (05 §8), derived attributes, level curves and crew-mission crits (06 §7.3).",
  "curves": {
    "TurnRate": { "keys": [0, 0.3, 0.5, 0.75, 1], "values": [0.6, 0.9, 1, 0.85, 0.7] },
    "XpPerLevel": { "keys": [1, 10, 25, 50, 90], "values": [100, 1500, 9000, 40000, 250000] }
  },
  "cases": [
    { "name": "formula.turret_hit_chance",
      "src": "formula TurretHitChance(src, tgt, ctx) =\n  0.5 ^ ( (ctx.angularVelocity * 40000 / (attr(src,TrackingSpeed) * attr(tgt,SignatureRadius)))^2\n        + (max(0, ctx.distance - attr(src,OptimalRange)) / attr(src,FalloffRange))^2 )",
      "bytecode": "e01d9ab81c36192c", "type": "num",
      "inputs": { "attrs": { "src": { "TrackingSpeed": 0.05, "OptimalRange": 10000, "FalloffRange": 5000 }, "tgt": { "SignatureRadius": 40 } },
                  "fields": { "ctx": { "angularVelocity": 0.01, "distance": 15000 } } },
      "expect": 0 },
    { "name": "formula.turret_hit_chance_sweep",
      "src": "formula TurretHitChance(src, v) = 0.5 ^ ((v.w * 40000 / (attr(src, TrackingSpeed) * v.sig))^2 + (max(0, v.d - attr(src, OptimalRange)) / attr(src, FalloffRange))^2)",
      "bytecode": "77507c4341a49e91", "inputs": { "attrs": { "src": { "TrackingSpeed": 0.0625, "OptimalRange": 24000, "FalloffRange": 12000 } } },
      "rows": { "param": "v", "fields": ["w", "sig", "d"], "data": [
        ["0", "40", "10000", 1], ["0.001", "40", "24000", "0x1p-256"], ["0.02", "125", "30000", 0], ["0.1", "35", "5000", 0],
        ["0.005", "400", "60000", "0x1p-73"], ["0.0333", "80", "24001", 0], ["1e-6", "2500", "36000", "0x1.fffffe79caf75p-02"], ["0.25", "30", "90000", 0]
      ] } },
    { "name": "formula.stacking_penalty_series",
      "src": "exp(-((v.i / 2.67) ^ 2))", "params": ["v"], "bytecode": "cca00198cc449461",
      "comment": "S(i) = e^-(i/2.67)^2 (06 §1.2): 1, 0.869, 0.571, 0.283, 0.106, 0.030, ...",
      "rows": { "fields": ["i"], "data": [["0", 1], ["1", "0x1.bcfd4b4bacfb6p-01"], ["2", "0x1.2423794a0dafap-01"], ["3", "0x1.21befef30ee5fp-02"], ["4", "0x1.b22559442e46ep-04"], ["5", "0x1.eb6011db7a219p-06"], ["6", "0x1.a41906d9e6c8bp-08"], ["7", "0x1.0f4c56821237bp-10"], ["8", "0x1.08afeb01063e5p-13"]] } },
    { "name": "formula.stacked_damage_mods",
      "src": "v.base * (1 + (v.f - 1) * exp(-((0 / 2.67) ^ 2))) * (1 + (v.f - 1) * exp(-((1 / 2.67) ^ 2))) * (1 + (v.f - 1) * exp(-((2 / 2.67) ^ 2)))",
      "params": ["v"], "bytecode": "60eac9d941e39a9c",
      "comment": "three identical 10 % damage modules under EVE stacking penalties",
      "rows": { "fields": ["base", "f"], "data": [["100", "1.1", "0x1.f9876753bee76p+06"], ["100", "0.9", "0x1.35f4b8e548201p+06"], ["37.5", "1.25", "0x1.04cc27332140dp+06"]] } },
    { "name": "formula.missile_damage",
      "src": "formula MissileDamage(m, t) = attr(m, Damage) * min(1, attr(t, Sig) / attr(m, ExplosionRadius), (attr(t, Sig) / attr(m, ExplosionRadius) * attr(m, ExplosionVelocity) / attr(t, Velocity)) ^ (ln(attr(m, Drf)) / ln(5.5)))",
      "bytecode": "7a7eb63a2de972e2",
      "inputs": { "attrs": { "m": { "Damage": 150, "ExplosionRadius": 125, "ExplosionVelocity": 85, "Drf": 0.882 }, "t": { "Sig": 40, "Velocity": 350 } } },
      "expect": 48 },
    { "name": "formula.capacitor_recharge",
      "src": "formula CapRecharge(ship) = (10 * attr(ship, Cap.Max) / attr(ship, Cap.Tau)) * (sqrt(attr(ship, Cap.Current) / attr(ship, Cap.Max)) - attr(ship, Cap.Current) / attr(ship, Cap.Max))",
      "bytecode": "4bd4006f799ec3bd",
      "inputs": { "attrs": { "ship": { "Cap.Max": 1250, "Cap.Tau": 312.5, "Cap.Current": 312.5 } } },
      "expect": 10, "comment": "dC/dt = (10 Cmax / tau)(sqrt(C/Cmax) - C/Cmax), 06 §8.5; at C = Cmax/4: 40 * (0.5 - 0.25)" },
    { "name": "formula.capacitor_recharge_sweep",
      "src": "(10 * v.cmax / v.tau) * (sqrt(v.c / v.cmax) - v.c / v.cmax)", "params": ["v"], "bytecode": "64205f88ff8648ca",
      "rows": { "fields": ["cmax", "tau", "c"], "data": [["1250", "312.5", "0", 0], ["1250", "312.5", "1250", 0], ["980", "245.25", "117.3", "0x1.2155eebef36eap+03"], ["5400", "1100.75", "4999.99", "0x1.c833480957d09p+00"]] } },
    { "name": "formula.thrust_to_weight", "src": "formula ThrustToWeight(ship) = attr(ship, MaxThrust) / (attr(ship, Mass) * 9.81);", "bytecode": "d0d5dd900902f57c",
      "inputs": { "attrs": { "ship": { "MaxThrust": 2500000, "Mass": 85000 } } }, "expect": "0x1.7fc316db5bbffp+01" },
    { "name": "formula.effective_hp", "src": "attr(self, Hull.Hp) / (1 - attr(self, Hull.Resist))", "bytecode": "f067bb8e776c2617",
      "inputs": { "attrs": { "self": { "Hull.Hp": 4200, "Hull.Resist": 0.33 } } }, "expect": "0x1.87ca81e9131adp+12" },
    { "name": "formula.effective_hp_all_layers",
      "src": "attr(self, Shield.Hp) / (1 - attr(self, Shield.Resist)) + attr(self, Armor.Hp) / (1 - attr(self, Armor.Resist)) + attr(self, Hull.Hp) / (1 - attr(self, Hull.Resist))",
      "bytecode": "795e606e21f36174",
      "inputs": { "attrs": { "self": { "Shield.Hp": 5000, "Shield.Resist": 0.5, "Armor.Hp": 3000, "Armor.Resist": 0.6, "Hull.Hp": 2000, "Hull.Resist": 0.33 } } },
      "expect": "0x1.40144c6afc2dep+14" },
    { "name": "formula.industry_duration",
      "src": "formula JobDuration(bp, pilot, facility) = bp.baseSecs * bp.runs * (1 - 0.04 * attr(pilot, Skill.Industry)) * (1 - 0.02 * attr(pilot, Skill.AdvancedIndustry)) * attr(facility, TimeMultiplier)",
      "bytecode": "65ca1915ad56149b",
      "inputs": { "attrs": { "pilot": { "Skill.Industry": 5, "Skill.AdvancedIndustry": 3 }, "facility": { "TimeMultiplier": 0.85 } },
                  "fields": { "bp": { "baseSecs": 3600, "runs": 10 } } },
      "expect": "0x1.678cccccccccdp+14" },
    { "name": "formula.industry_fee",
      "src": "formula JobFee(bp, facility) = ceil(bp.estimatedValue * bp.runs * (attr(facility, CostIndex) + attr(facility, TaxRate)))",
      "bytecode": "364b64ac3014b622",
      "inputs": { "attrs": { "facility": { "CostIndex": 0.0431, "TaxRate": 0.1 } }, "fields": { "bp": { "estimatedValue": 1234567.89, "runs": 3 } } },
      "expect": 530000 },
    { "name": "formula.vendor_price",
      "src": "formula VendorPrice(item, buyer, region) = floor(attr(item, BasePrice) * region.priceIndex * (1 + attr(region, SalesTax)) * (1 - clamp(attr(buyer, Standing.Vendor) * 0.02, 0, 0.2)) * 100) / 100",
      "bytecode": "02519aaaed0b0f33",
      "rows": { "param": "region", "fields": ["priceIndex"], "data": [["1", "0x1.eb63d70a3d70ap+08"], ["1.137", "0x1.175ae147ae148p+09"], ["0.8", "0x1.891c28f5c28f6p+08"]] },
      "inputs": { "attrs": { "item": { "BasePrice": 499.99 }, "buyer": { "Standing.Vendor": 4.5 }, "region": { "SalesTax": 0.08 } } } },
    { "name": "formula.crafting_quality",
      "src": "(v.oq * 0.5 + v.cd * 0.3 + v.dr * 0.2) / 1000 * (1 + 0.05 * v.experiment)", "params": ["v"], "bytecode": "8d0127d5e6325bff",
      "rows": { "fields": ["oq", "cd", "dr", "experiment"], "data": [["800", "650", "900", "0", "0x1.8cccccccccccdp-01"], ["1000", "1000", "1000", "4", "0x1.3333333333333p+00"], ["123", "456", "789", "2", "0x1.911c6d1e108c5p-02"]] } },
    { "name": "formula.xp_curve", "src": "floor(curve(XpPerLevel, level()) * (1 + 0.1 * stacks()))", "bytecode": "3db532697ce12874",
      "inputs": { "level": 33, "stacks": 2 }, "expect": 22704 },
    { "name": "formula.xp_power", "src": "floor(100 * level() ^ 1.5)", "bytecode": "39504d63be9ba140", "inputs": { "level": 17 }, "expect": 7009 },
    { "name": "formula.blue_zone_turn_rate", "src": "attr(self, TurnRate.Max) * curve(TurnRate, ctx.speed / attr(self, MaxSpeed))",
      "params": ["self", "ctx"], "bytecode": "dfda5bba3a50fcf5",
      "inputs": { "attrs": { "self": { "TurnRate.Max": 90, "MaxSpeed": 400 } } },
      "rows": { "param": "ctx", "fields": ["speed"], "data": [["0", 54], ["120", 81], ["200", 90], ["250", "0x1.4dp+06"], ["399", "0x1.f9147ae147aep+05"], ["800", "0x1.f7fffffffffffp+05"]] } },
    { "name": "formula.shield_regen_combat", "src": "select(tag(self, State.Combat), attr(self, Shield.Regen) * 0.25, attr(self, Shield.Regen))",
      "bytecode": "4d6de54851ed0b99",
      "inputs": { "attrs": { "self": { "Shield.Regen": 48 } }, "tags": { "self": ["State.Combat.Engaged"] } }, "expect": 12 },
    { "name": "formula.crew_mission_crit", "src": "clamp(0.05 + 0.01 * attr(crew, Skill.Level) + 0.02 * attr(crew, Influence.Rank), 0, 0.5)",
      "params": ["crew"], "bytecode": "043dbc8fca9f0304",
      "inputs": { "attrs": { "crew": { "Skill.Level": 38, "Influence.Rank": 9 } } }, "expect": 0.5 },
    { "name": "formula.crew_mission_crit_low", "src": "clamp(0.05 + 0.01 * attr(crew, Skill.Level) + 0.02 * attr(crew, Influence.Rank), 0, 0.5)",
      "params": ["crew"], "bytecode": "043dbc8fca9f0304",
      "inputs": { "attrs": { "crew": { "Skill.Level": 12, "Influence.Rank": 3 } } }, "expect": "0x1.d70a3d70a3d7p-03" },
    { "name": "formula.taming_chance", "src": "formula TameChance(tamer, creature) = clamp(0.5 + (attr(tamer, Skill.Taming) - attr(creature, Level)) * 0.04 - select(tag(creature, Creature.Aggressive), 0.15, 0), 0.02, 0.95)",
      "bytecode": "0fa6fa1102741397",
      "inputs": { "attrs": { "tamer": { "Skill.Taming": 45 }, "creature": { "Level": 40 } }, "tags": { "creature": ["Creature.Aggressive.Territorial"] } },
      "expect": "0x1.1999999999999p-01" },
    { "name": "formula.asinh_scaling", "src": "2 * asinh(attr(self, Raw) / 2)", "bytecode": "b276a199ae8d2e5b",
      "inputs": { "attrs": { "self": { "Raw": 1000 } } }, "expect": "0x1.ba18adcabd78ap+03" },
    { "name": "formula.bool_validator", "src": "attr(self, Mass) > 0 && attr(self, Volume) >= 0 && !(attr(self, StackMax) < 1)", "expectType": "bool",
      "bytecode": "d3d2f203a0951cda", "inputs": { "attrs": { "self": { "Mass": 2.5, "Volume": 0, "StackMax": 1 } } }, "expect": true }
  ]
}
