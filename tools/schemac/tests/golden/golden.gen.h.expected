/// Named dirty-bit mutators for golden.all.Motion (replicate(owner)).
template <>
class Mut<::golden::all::Motion> : public detail::MutBase<::golden::all::Motion> {
public:
    using MutBase::MutBase;
    static constexpr ::helios::u64 kPos = 1ull << 0;
    static constexpr ::helios::u64 kVel = 1ull << 1;
    static constexpr ::helios::u64 kHp = 1ull << 2;
    static constexpr ::helios::u64 kAllFields = kPos | kVel | kHp;
    /// Writes pos and marks it dirty if the value changed.
    void setPos(const ::helios::refl::WorldPos& value) {
        if (::helios::refl::valuesEqual(m_c->pos, value)) return;
        m_c->pos = value;
        markBits(kPos);
    }
    /// In-place access to pos; marks it dirty.
    ::helios::refl::WorldPos& editPos() noexcept {
        markBits(kPos);
        return m_c->pos;
    }
    /// Writes vel and marks it dirty if the value changed.
    void setVel(const ::helios::Vec3& value) {
        if (::helios::refl::valuesEqual(m_c->vel, value)) return;
        m_c->vel = value;
        markBits(kVel);
    }
    /// In-place access to vel; marks it dirty.
    ::helios::Vec3& editVel() noexcept {
        markBits(kVel);
        return m_c->vel;
    }
    /// Writes hp and marks it dirty if the value changed.
    void setHp(const ::helios::f32& value) {
        if (::helios::refl::valuesEqual(m_c->hp, value)) return;
        m_c->hp = value;
        markBits(kHp);
    }
    /// In-place access to hp; marks it dirty.
    ::helios::f32& editHp() noexcept {
        markBits(kHp);
        return m_c->hp;
    }
    /// Mutable access to the whole component; marks every replicated field dirty.
    ::golden::all::Motion& raw() noexcept {
        markBits(kAllFields);
        return *m_c;
    }
};

