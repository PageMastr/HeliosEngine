        case 6u: return ::helios::refl::readKnownField(r, tag.wire, v.u8v);
        case 7u: return ::helios::refl::readKnownField(r, tag.wire, v.u16v);
        case 8u: return ::helios::refl::readKnownField(r, tag.wire, v.u32v);
        case 9u: return ::helios::refl::readKnownField(r, tag.wire, v.u64v);
        case 10u: return ::helios::refl::readKnownField(r, tag.wire, v.f32v);
        case 11u: return ::helios::refl::readKnownField(r, tag.wire, v.f64v);
        case 12u: return ::helios::refl::readKnownField(r, tag.wire, v.s);
        case 13u: return ::helios::refl::readKnownField(r, tag.wire, v.n);
        case 14u: return ::helios::refl::readKnownField(r, tag.wire, v.g);
        case 15u: return ::helios::refl::readKnownField(r, tag.wire, v.v2);
        case 16u: return ::helios::refl::readKnownField(r, tag.wire, v.v3);
        case 17u: return ::helios::refl::readKnownField(r, tag.wire, v.v4);
        case 18u: return ::helios::refl::readKnownField(r, tag.wire, v.v3d);
        case 19u: return ::helios::refl::readKnownField(r, tag.wire, v.q);
        case 20u: return ::helios::refl::readKnownField(r, tag.wire, v.qd);
        case 21u: return ::helios::refl::readKnownField(r, tag.wire, v.c);
        case 22u: return ::helios::refl::readKnownField(r, tag.wire, v.wp);
        case 23u: return ::helios::refl::readKnownField(r, tag.wire, v.e);
        case 24u: return ::helios::refl::readKnownField(r, tag.wire, v.nh);
        case 25u: return ::helios::refl::readKnownField(r, tag.wire, v.d);
        case 26u: return ::helios::refl::readKnownField(r, tag.wire, v.t);
        case 27u: return ::helios::refl::readKnownField(r, tag.wire, v.loc);
        case 28u: return ::helios::refl::readKnownField(r, tag.wire, v.tags);
        case 29u: return ::helios::refl::readKnownField(r, tag.wire, v.tq);
        case 30u: return ::helios::refl::readKnownField(r, tag.wire, v.hx);
        case 31u: return ::helios::refl::readKnownField(r, tag.wire, v.col);
        case 32u: return ::helios::refl::readKnownField(r, tag.wire, v.perm);
        default: return false;
    }
}

