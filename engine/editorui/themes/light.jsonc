// Helios editor theme: light. See dark.jsonc for the format and the contrast rule (4.5:1).
{
  "name": "light",
  "highContrast": false,
  "colors": {
    "text": "#1B1F24",
    "textDisabled": "#535A64",
    "windowBg": "#F3F4F6",
    "childBg": "#F3F4F6",
    "popupBg": "#FFFFFF",
    "border": "#B8BEC6",
    "frameBg": "#FFFFFF",
    "frameBgHovered": "#E6EEF8",
    "frameBgActive": "#D5E3F3",
    "titleBg": "#E1E4E8",
    "titleBgActive": "#D3D8DE",
    "menuBarBg": "#E1E4E8",
    "scrollbarBg": "#EBEDF0",
    "scrollbarGrab": "#A7AEB7",
    "checkMark": "#1F5FAD",
    "sliderGrab": "#1F5FAD",
    "button": "#CFE0F5",
    "buttonHovered": "#B9D2F0",
    "buttonActive": "#A4C4EA",
    "header": "#D6E4F4",
    "headerHovered": "#C4D8EF",
    "headerActive": "#BDD3EE",
    "separator": "#C3C8CF",
    "tab": "#E1E4E8",
    "tabHovered": "#C4D8EF",
    "tabSelected": "#F3F4F6",
    "tabDimmed": "#E8EAED",
    "tabDimmedSelected": "#EEF0F2",
    "dockingPreview": "#1F5FAD55",
    "tableHeaderBg": "#E4E7EB",
    "tableRowBgAlt": "#0000000A",
    "textSelectedBg": "#1F5FAD44",
    "navHighlight": "#1F5FAD",
    "statusBarBg": "#E1E4E8",
    "accentLocal": "#A7AEB7",
    "accentShared": "#B7791F",
    "accentLive": "#C53030",
    "badgeServer": "#9C4A00",
    "badgeClient": "#256B2A",
    "dirty": "#7A5800",
    "error": "#B42318",
    "viewportBg": "#DADFE5",
    "viewportGrid": "#C3CAD3"
  },
  "metrics": {
    "fontSize": 15,
    "windowRounding": 2,
    "frameRounding": 2,
    "tabRounding": 2,
    "windowBorderSize": 1,
    "frameBorderSize": 1,
    "framePaddingX": 6,
    "framePaddingY": 3,
    "itemSpacingX": 8,
    "itemSpacingY": 4
  }
}
